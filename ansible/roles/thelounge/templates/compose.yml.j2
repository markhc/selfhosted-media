# Managed by Ansible. The Lounge is reachable only through the shared network.
name: selfhosted-thelounge
services:
  thelounge:
    image: {{ thelounge_image }}
    networks:
      - selfhosted
    restart: unless-stopped
    user: "1000:1000"
    environment:
      TZ: {{ thelounge_timezone | to_json }}
    healthcheck:
      test:
        - CMD
        - node
        - -e
        - >-
          require('http').get('http://127.0.0.1:{{ thelounge_port }}/',
          r => { r.resume(); process.exit(r.statusCode === 200 ? 0 : 1); })
          .on('error', () => process.exit(1))
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 20s
    volumes:
      - ./data:/var/opt/thelounge
networks:
  selfhosted:
    external: true
    name: selfhosted
