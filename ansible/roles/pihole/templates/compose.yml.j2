# Managed by Ansible. Pi-hole answers DNS on the LAN address only, and its web
# interface listens on loopback only, behind Caddy.
name: selfhosted-pihole
services:
  pihole:
    image: {{ pihole_image }}
    network_mode: host
    restart: unless-stopped
    # The image's start script runs as root to prepare /etc/pihole, then grants
    # pihole-FTL file capabilities and runs it as the pihole user. Gaining those
    # capabilities on exec rules out no-new-privileges.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - KILL
      - NET_BIND_SERVICE
      - SETFCAP
      - SETGID
      - SETPCAP
      - SETUID
    secrets:
      - webpassword
    environment:
      WEBPASSWORD_FILE: webpassword
      PIHOLE_UID: "{{ pihole_uid }}"
      PIHOLE_GID: "{{ pihole_gid }}"
      TZ: {{ pihole_timezone | to_json }}
      # FTLCONF_ settings override pihole.toml on every start and are read-only in the web interface.
      # Answer DNS only on the LAN address, never on Tailscale, Docker, or loopback
      # interfaces; bind-dynamic also binds it when it appears after a boot.
      FTLCONF_dns_listeningMode: NONE
      FTLCONF_misc_dnsmasq_lines: "listen-address={{ pihole_dns_address }};bind-dynamic"
      FTLCONF_dns_upstreams: {{ pihole_upstreams | join(';') | to_json }}
      FTLCONF_dns_hostRecord: {{ pihole_host_record | to_json }}
      # Plain HTTP on loopback only: no HTTPS listener to collide with Caddy on 443.
      FTLCONF_webserver_port: "127.0.0.1:{{ pihole_port }}"
      FTLCONF_webserver_domain: {{ pihole_hostname | to_json }}
      # The NAS keeps its own clock: no NTP server, and no clock changes.
      FTLCONF_ntp_ipv4_active: "false"
      FTLCONF_ntp_ipv6_active: "false"
      FTLCONF_ntp_sync_active: "false"
    # The image's own check queries 127.0.0.1, where Pi-hole does not listen.
    healthcheck:
      test:
        - CMD
        - dig
        - +short
        - +norecurse
        - +retry=0
        - "@{{ pihole_dns_address }}"
        - pi.hole
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 120s
    volumes:
      - ./etc-pihole:/etc/pihole
secrets:
  webpassword:
    file: ./webpassword
