# Managed by Ansible. Docker publishes DNS on the LAN address only; the web UI
# stays on the shared network behind Caddy.
name: selfhosted-pihole
services:
  pihole:
    image: {{ pihole_image }}
    networks:
      - selfhosted
    ports:
      - "{{ pihole_dns_address }}:53:53/tcp"
      - "{{ pihole_dns_address }}:53:53/udp"
    restart: unless-stopped
    # The image's start script runs as root to prepare /etc/pihole, then grants
    # pihole-FTL file capabilities and runs it as the pihole user. Gaining those
    # capabilities on exec rules out no-new-privileges.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - FOWNER
      - KILL
      - NET_BIND_SERVICE
      - SETFCAP
      - SETGID
      - SETPCAP
      - SETUID
    secrets:
      - webpassword
    environment:
      WEBPASSWORD_FILE: webpassword
      PIHOLE_UID: "{{ pihole_uid }}"
      PIHOLE_GID: "{{ pihole_gid }}"
      TZ: {{ pihole_timezone | to_json }}
      # FTLCONF_ settings override pihole.toml on every start and are read-only in the web interface.
      # Docker limits host exposure to the selected LAN address.
      FTLCONF_dns_listeningMode: ALL
      FTLCONF_dns_upstreams: {{ pihole_upstreams | join(';') | to_json }}
      FTLCONF_dns_hostRecord: {{ pihole_host_record | to_json }}
      # Plain HTTP inside the shared network; Caddy owns host port 443.
      FTLCONF_webserver_port: "0.0.0.0:{{ pihole_port }}"
      FTLCONF_webserver_domain: {{ pihole_hostname | to_json }}
      # The NAS keeps its own clock: no NTP server, and no clock changes.
      FTLCONF_ntp_ipv4_active: "false"
      FTLCONF_ntp_ipv6_active: "false"
      FTLCONF_ntp_sync_active: "false"
    healthcheck:
      test:
        - CMD
        - dig
        - +short
        - +norecurse
        - +retry=0
        - "@127.0.0.1"
        - pi.hole
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 120s
    volumes:
      - ./etc-pihole:/etc/pihole
secrets:
  webpassword:
    file: ./webpassword
networks:
  selfhosted:
    external: true
    name: selfhosted
