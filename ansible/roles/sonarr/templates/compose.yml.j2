# Managed by Ansible. {{ sonarr_instance_name }} is reachable only through the shared network.
name: selfhosted-{{ sonarr_instance_name }}
services:
  {{ sonarr_instance_name }}:
    image: {{ sonarr_image }}
    networks:
      - selfhosted
    restart: unless-stopped
    # The image's init starts as root only to run Sonarr as PUID:PGID and own /config.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    env_file:
      - ./api.env
    # These settings override config.xml on every start.
    environment:
      SONARR__SERVER__BINDADDRESS: 0.0.0.0
      SONARR__SERVER__PORT: "{{ sonarr_port }}"
      # Caddy terminates TLS and proxies the hostname's root.
      SONARR__SERVER__ENABLESSL: "false"
      SONARR__SERVER__URLBASE: ""
      SONARR__SERVER__ALLOWEDHOSTS: {{ sonarr_allowed_hosts | join(',') | to_json }}
      # Caddy connects from the shared network, which must not bypass the login.
      SONARR__AUTH__REQUIRED: Enabled
      SONARR__LOG__LEVEL: {{ sonarr_log_level | to_json }}
      PUID: "{{ sonarr_uid }}"
      PGID: "{{ sonarr_gid }}"
      UMASK: {{ sonarr_umask | to_json }}
      TZ: {{ sonarr_timezone | to_json }}
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --max-time
        - "5"
        - --output
        - /dev/null
        - http://127.0.0.1:{{ sonarr_port }}/ping
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 60s
    volumes:
      - ./config:/config
      - type: bind
        source: {{ sonarr_data_path | replace('$', '$$') | to_json }}
        target: {{ sonarr_data_container_path | to_json }}
        bind:
          create_host_path: false
networks:
  selfhosted:
    external: true
    name: selfhosted
