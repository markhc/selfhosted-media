# Managed by Ansible. The WebUI stays on the shared network; only peer traffic is published.
name: selfhosted-qbittorrent
services:
  qbittorrent:
    image: {{ qbittorrent_image }}
    networks:
      - selfhosted
    ports:
      - "{{ qbittorrent_torrenting_port }}:{{ qbittorrent_torrenting_port }}/tcp"
      - "{{ qbittorrent_torrenting_port }}:{{ qbittorrent_torrenting_port }}/udp"
    restart: unless-stopped
    user: "{{ qbittorrent_uid }}:{{ qbittorrent_gid }}"
    read_only: true
    tmpfs:
      - /tmp
    # The default 10 seconds can interrupt qBittorrent saving its resume data.
    stop_grace_period: 30m
    environment:
      QBT_LEGAL_NOTICE: confirm
      QBT_WEBUI_PORT: "{{ qbittorrent_webui_port }}"
      QBT_TORRENTING_PORT: "{{ qbittorrent_torrenting_port }}"
      UMASK: {{ qbittorrent_umask | to_json }}
      TZ: {{ qbittorrent_timezone | to_json }}
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --max-time
        - "5"
        - --output
        - /dev/null
        - http://127.0.0.1:{{ qbittorrent_webui_port }}/
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 30s
    volumes:
      - ./config:/config
      - type: bind
        source: {{ qbittorrent_data_path | replace('$', '$$') | to_json }}
        target: {{ qbittorrent_data_container_path | to_json }}
        bind:
          create_host_path: false
{% for mount in qbittorrent_mounts %}
      - type: bind
        source: {{ mount.path | replace('$', '$$') | to_json }}
        target: {{ mount.target | to_json }}
        read_only: {{ mount.read_only | default(true) | bool | to_json }}
        bind:
          create_host_path: false
{% endfor %}
networks:
  selfhosted:
    external: true
    name: selfhosted
