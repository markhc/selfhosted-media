# Managed by Ansible. cAdvisor is optional because it needs broad read access to host container state.
name: selfhosted-cadvisor
services:
  cadvisor:
    image: {{ cadvisor_image }}
    network_mode: host
    restart: unless-stopped
    privileged: true
    command:
      - --listen_ip={{ cadvisor_listen_address }}
      - --port={{ cadvisor_port }}
      - --housekeeping_interval={{ cadvisor_housekeeping_interval }}
      - --docker_only=true
      - --store_container_labels=false
    # The image's inherited check probes localhost, but cAdvisor deliberately
    # listens only on its dedicated loopback address.
    healthcheck:
      test:
        - CMD
        - wget
        - --quiet
        - --tries=1
        - --spider
        - http://{{ cadvisor_listen_address }}:{{ cadvisor_port }}/healthz
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    devices:
      - /dev/kmsg:/dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
