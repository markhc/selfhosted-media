# Managed by Ansible. A read-only socket bind still grants root-equivalent Docker API access.
name: selfhosted-alloy
services:
  alloy:
    image: {{ alloy_image }}
    network_mode: host
    restart: unless-stopped
    user: "{{ alloy_uid }}:{{ alloy_gid }}"
    group_add:
      # Socket access is root-equivalent; grant only its host group rather than
      # running Alloy as root.
      - "{{ alloy_docker_socket.stat.gid }}"
    read_only: true
    mem_limit: {{ alloy_memory_limit }}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    command:
      - run
      - --server.http.listen-addr={{ alloy_listen_address }}:{{ alloy_port }}
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./config.alloy:/etc/alloy/config.alloy:ro
      - ./data:/var/lib/alloy/data
