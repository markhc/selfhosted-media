{
	# Never create a wildcard HTTP listener, including automatic redirects.
	auto_https disable_redirects
	admin localhost:2019
}

# Every service site imports this: private listeners and DNS-01 certificates only.
(selfhosted_private) {
	# Docker publishes this listener only on the selected Tailscale and LAN addresses.
	bind 0.0.0.0
	tls {
		ca {{ caddy_acme_ca }}
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
}

# Service roles publish their sites here through the caddy role's site tasks.
import sites/*.caddy
