# Managed by Ansible. Docker publishes HTTPS only on the private host addresses.
name: selfhosted-caddy
services:
  caddy:
    image: selfhosted/caddy-cloudflare:{{ caddy_version }}-{{ caddy_cloudflare_version }}
    build:
      context: ./build
    ports:
      - "{{ caddy_tailscale_ip.stdout | trim }}:443:443"
{% if caddy_lan_ip %}
      - "{{ caddy_lan_ip }}:443:443"
{% endif %}
    networks:
      selfhosted:
        ipv4_address: 172.30.0.2
    restart: unless-stopped
    env_file:
      - ./cloudflare.env
    environment:
      TZ: {{ caddy_timezone | to_json }}
    volumes:
      - ./conf:/etc/caddy:ro
      - ./data:/data
      - ./config:/config
networks:
  selfhosted:
    external: true
    name: selfhosted
