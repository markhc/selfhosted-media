# Managed by Ansible. node_exporter reads the host through a read-only root mount.
name: selfhosted-node_exporter
services:
  node-exporter:
    image: {{ node_exporter_image }}
    network_mode: host
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ node_exporter_listen_address }}:{{ node_exporter_port }}
      # Disabled-by-default collectors used by the full Grafana dashboard.
      - --collector.processes
      - --collector.tcpstat
    volumes:
      - /:/host:ro,rslave
