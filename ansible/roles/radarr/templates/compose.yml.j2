# Managed by Ansible. {{ radarr_instance_name }} listens on its own loopback address only, behind Caddy.
name: selfhosted-{{ radarr_instance_name }}
services:
  radarr:
    image: {{ radarr_image }}
    network_mode: host
    restart: unless-stopped
    # The image's init starts as root only to run Radarr as PUID:PGID and own /config.
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - SETGID
      - SETUID
    security_opt:
      - no-new-privileges:true
    # Peers in the media stack, by name.
    extra_hosts:
{% for name, address in media_hosts_addresses | dictsort %}
      - "{{ name }}:{{ address }}"
{% endfor %}
    env_file:
      - ./api.env
    # These settings override config.xml on every start.
    environment:
      RADARR__SERVER__BINDADDRESS: {{ radarr_instance.address | to_json }}
      RADARR__SERVER__PORT: "{{ radarr_port }}"
      # Caddy terminates TLS and proxies the hostname's root.
      RADARR__SERVER__ENABLESSL: "false"
      RADARR__SERVER__URLBASE: ""
      RADARR__SERVER__ALLOWEDHOSTS: {{ radarr_allowed_hosts | join(',') | to_json }}
      # Caddy connects from loopback, which must not bypass the login.
      RADARR__AUTH__REQUIRED: Enabled
      RADARR__LOG__LEVEL: {{ radarr_log_level | to_json }}
      PUID: "{{ radarr_uid }}"
      PGID: "{{ radarr_gid }}"
      UMASK: {{ radarr_umask | to_json }}
      TZ: {{ radarr_timezone | to_json }}
    healthcheck:
      test:
        - CMD
        - curl
        - --fail
        - --silent
        - --max-time
        - "5"
        - --output
        - /dev/null
        - http://{{ radarr_instance.address }}:{{ radarr_port }}/ping
      interval: 10s
      timeout: 10s
      retries: 6
      start_period: 60s
    volumes:
      - ./config:/config
      - type: bind
        source: {{ radarr_data_path | replace('$', '$$') | to_json }}
        target: {{ radarr_data_container_path | to_json }}
        bind:
          create_host_path: false
