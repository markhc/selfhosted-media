# Managed by Ansible.
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [{{ (prometheus_listen_address ~ ':' ~ prometheus_port) | to_json }}]
{% if node_exporter_enabled | default(false) | bool %}
  - job_name: node
    static_configs:
      - targets: [{{ (monitoring_targets_addresses.node_exporter ~ ':' ~ node_exporter_port | default(9100)) | to_json }}]
        labels:
          host: {{ inventory_hostname | to_json }}
{% endif %}
{% if cadvisor_enabled | default(false) | bool %}
  - job_name: cadvisor
    static_configs:
      - targets: [{{ (monitoring_targets_addresses.cadvisor ~ ':' ~ cadvisor_port | default(8080)) | to_json }}]
        labels:
          host: {{ inventory_hostname | to_json }}
{% endif %}
