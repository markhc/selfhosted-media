# Managed by Ansible. Loki is loopback-only and has a hard memory ceiling.
name: selfhosted-loki
services:
  loki:
    image: {{ loki_image }}
    network_mode: host
    restart: unless-stopped
    user: "10001:10001"
    read_only: true
    mem_limit: {{ loki_memory_limit }}
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    command:
      - -config.file=/etc/loki/loki.yml
    volumes:
      - ./loki.yml:/etc/loki/loki.yml:ro
      - ./data:/loki
