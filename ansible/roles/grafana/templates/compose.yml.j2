# Managed by Ansible. Grafana listens on loopback only, behind Caddy.
name: selfhosted-grafana
services:
  grafana:
    image: {{ grafana_image }}
    network_mode: host
    restart: unless-stopped
    user: "{{ grafana_uid }}:{{ grafana_gid }}"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    tmpfs:
      - /tmp
    secrets:
      - admin_password
    environment:
      GF_SERVER_HTTP_ADDR: {{ grafana_listen_address | to_json }}
      GF_SERVER_HTTP_PORT: "{{ grafana_port }}"
      GF_SERVER_DOMAIN: {{ grafana_hostname | to_json }}
      GF_SERVER_ROOT_URL: {{ ('https://' ~ grafana_hostname) | to_json }}
      GF_SERVER_ENFORCE_DOMAIN: "true"
      GF_SECURITY_ADMIN_USER: {{ grafana_admin_user | to_json }}
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/admin_password
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_AUTH_ANONYMOUS_ENABLED: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES: "false"
      # Grafana 13.2+ bundles data sources as standalone plugins under its image
      # root. Updates happen with the pinned image because that root is read-only.
      GF_PLUGINS_PREINSTALL_AUTO_UPDATE: "false"
    healthcheck:
      # Domain enforcement redirects an IP-address Host header to HTTPS. Probe
      # the loopback listener while presenting the configured public hostname.
      test: [CMD-SHELL, {{ ("wget --quiet --spider --header='Host: " ~ grafana_hostname ~ "' http://" ~ grafana_listen_address ~ ":" ~ (grafana_port | string) ~ "/api/health || exit 1") | to_json }}]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
    volumes:
      - ./data:/var/lib/grafana
      - ./provisioning:/etc/grafana/provisioning:ro
      - ./dashboards:/var/lib/grafana/dashboards:ro
secrets:
  admin_password:
    file: ./admin_password
